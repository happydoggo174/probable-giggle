{
  "name": "app",
  "version": "1.0.50",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "./server",
    "docker": "docker restart -t 0 app-bun_server-1",
    "commit": "git add . && git commit && git push origin main",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server src/index.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.2",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.7.0",
    "elysia": "1.4.29",
    "jose": "^6.2.8",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "bun-types": "1.3.14"
  },
  "module": "src/index.js"
}
